{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jiad-bukku-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat"],
  "alias": {
    "core": "./vendor/bukku/packages/core/src/index.ts"
  },
  "migrations": [
    {
      "tag": "v2-remove-container",
      "deleted_classes": ["BukkuMcpContainer"]
    }
  ],
  "routes": [
    {
      "pattern": "bukku.jusniiljas.com",
      "custom_domain": true
    }
  ]
}
