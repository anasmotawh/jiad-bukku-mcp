{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jiad-bukku-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat"],
  "alias": {
    "core": "./vendor/bukku/packages/core/src/index.ts"
  },
  "exports": {
    "BukkuMcpContainer": {
      "type": "durable-object",
      "state": "deleted"
    }
  },
  "routes": [
    {
      "pattern": "bukku.jusniiljas.com",
      "custom_domain": true
    }
  ]
}
